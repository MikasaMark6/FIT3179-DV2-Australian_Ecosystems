{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly comparison of vegetation composition: full 25-type extant classified-native denominator on the left and publicly mapped protected classified-native denominator on the right. Ten representative types are shown. Both magnitude scales are 0\u201340%.",
  "background": null,
  "data": {
    "url": "../data/chart11_representation.json"
  },
  "transform": [
    {
      "filter": "datum.default_comparison"
    },
    {
      "calculate": "datum.mvg_code == 1 ? \"Rainforests / vine thickets\" : datum.mvg_code == 9 ? \"Melaleuca forests / woodlands\" : datum.mvg_code == 14 ? \"Mallee woodlands / shrubs\" : datum.mvg_name",
      "as": "short_name"
    }
  ],
  "params": [
    {
      "name": "representationFocus",
      "value": 0
    }
  ],
  "spacing": 4,
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "gridColor": "#e6e8df",
      "domain": false,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontWeight": "normal",
      "titleFontWeight": "normal",
      "labelColor": "#344b3f",
      "titleColor": "#344b3f"
    },
    "title": {
      "font": "Arial",
      "fontSize": 14,
      "color": "#344b3f",
      "fontWeight": "normal"
    }
  },
  "resolve": {
    "scale": {
      "y": "shared",
      "x": "independent"
    }
  },
  "hconcat": [
    {
      "width": 280,
      "height": 280,
      "title": "All native vegetation",
      "mark": {
        "type": "bar",
        "color": "#85956d",
        "height": 20,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",
          "sort": {
            "field": "share_of_classified_native_pct",
            "order": "descending",
            "op": "max"
          },
          "axis": null
        },
        "x": {
          "field": "share_of_classified_native_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Share (%)",
            "values": [
              0,
              10,
              20,
              30,
              40
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "representationFocus == 0 || datum.mvg_code == representationFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Vegetation type",
            "type": "nominal"
          },
          {
            "field": "share_of_classified_native_pct",
            "title": "Share of all classified native vegetation (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "share_of_mapped_protected_classified_native_pct",
            "title": "Share within public protection (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "representation_difference_pp",
            "title": "Protected minus all-native share (pp)",
            "type": "quantitative",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "width": 210,
      "height": 280,
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 14,
        "color": "#344b3f",
        "cursor": "pointer",
        "font": "Arial",
        "fontWeight": "normal"
      },
      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",
          "sort": {
            "field": "share_of_classified_native_pct",
            "order": "descending",
            "op": "max"
          },
          "axis": null
        },
        "text": {
          "field": "short_name"
        },
        "opacity": {
          "condition": {
            "test": "representationFocus == 0 || datum.mvg_code == representationFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Vegetation type",
            "type": "nominal"
          },
          {
            "field": "share_of_classified_native_pct",
            "title": "Share of all classified native vegetation (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "share_of_mapped_protected_classified_native_pct",
            "title": "Share within public protection (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "representation_difference_pp",
            "title": "Protected minus all-native share (pp)",
            "type": "quantitative",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "width": 280,
      "height": 280,
      "title": "Within public protection",
      "mark": {
        "type": "bar",
        "color": "#315d49",
        "height": 20,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",
          "sort": {
            "field": "share_of_classified_native_pct",
            "order": "descending",
            "op": "max"
          },
          "axis": null
        },
        "x": {
          "field": "share_of_mapped_protected_classified_native_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "reverse": false,
            "nice": false
          },
          "axis": {
            "title": "Share (%)",
            "values": [
              0,
              10,
              20,
              30,
              40
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "representationFocus == 0 || datum.mvg_code == representationFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Vegetation type",
            "type": "nominal"
          },
          {
            "field": "share_of_classified_native_pct",
            "title": "Share of all classified native vegetation (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "share_of_mapped_protected_classified_native_pct",
            "title": "Share within public protection (%)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "representation_difference_pp",
            "title": "Protected minus all-native share (pp)",
            "type": "quantitative",
            "format": "+.2f"
          }
        ]
      }
    }
  ],
  "bounds": "flush"
}