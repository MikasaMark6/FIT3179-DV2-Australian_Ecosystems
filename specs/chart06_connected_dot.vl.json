{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "width": 600,
  "height": 280,
  "padding": 8,
  "params": [
    {
      "name": "landscapeFocus",
      "value": 0
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#344b3f",
      "titleColor": "#344b3f",
      "gridColor": "#e4e8dd",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelLimit": 300,
      "titleLimit": 380
    }
  },
  "description": "Connected dot plot comparing estimated pre-1750 and extant NVIS v7 category areas on their common known footprint. These are two dataset themes, not a continuous time series. Data preparation supplies ten default comparison types and short labels.",
  "data": {
    "url": "../data/chart06_pre1750_vs_extant.json"
  },
  "transform": [
    {
      "filter": "datum.default_comparison"
    },
    {
      "calculate": "datum.mvg_code == 1 ? \"Rainforests & vine thickets\" : datum.mvg_code == 3 ? \"Open eucalypt forests\" : datum.mvg_code == 5 ? \"Eucalypt woodlands\" : datum.mvg_code == 9 ? \"Melaleuca forests & woodlands\" : datum.mvg_code == 14 ? \"Mallee woodlands & shrublands\" : datum.mvg_code == 16 ? \"Acacia shrublands\" : datum.mvg_code == 18 ? \"Heathlands\" : datum.mvg_code == 19 ? \"Tussock grasslands\" : datum.mvg_code == 20 ? \"Hummock grasslands\" : datum.mvg_code == 23 ? \"Mangroves\" : datum.mvg_name",
      "as": "label"
    },
    {
      "calculate": "datum.estimated_pre1750_km2 / 1000000",
      "as": "pre_million_km2"
    },
    {
      "calculate": "datum.extant_km2 / 1000000",
      "as": "ext_million_km2"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#aeb9a5"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "estimated_pre1750_km2",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 265
          }
        },
        "x": {
          "field": "pre_million_km2",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1.5
            ],
            "nice": false,
            "zero": true
          },
          "axis": {
            "title": "Mapped area on the common known footprint (million km²)",
            "values": [
              0,
              0.5,
              1,
              1.5
            ],
            "format": ".1f"
          }
        },
        "x2": {
          "field": "ext_million_km2"
        },
        "opacity": {
          "condition": {
            "test": "landscapeFocus == 0 || datum.mvg_code == landscapeFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "type": "nominal",
            "title": "Vegetation type"
          },
          {
            "field": "estimated_pre1750_km2",
            "type": "quantitative",
            "title": "Estimated pre-1750 area (km²)",
            "format": ",.0f"
          },
          {
            "field": "extant_km2",
            "type": "quantitative",
            "title": "Extant area (km²)",
            "format": ",.0f"
          },
          {
            "field": "net_category_area_difference_km2",
            "type": "quantitative",
            "title": "Extant minus pre-1750 (km²)",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "fill": "#fffdf7",
        "stroke": "#85956d",
        "strokeWidth": 2,
        "size": 170,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "estimated_pre1750_km2",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 265
          }
        },
        "x": {
          "field": "pre_million_km2",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1.5
            ],
            "nice": false,
            "zero": true
          },
          "axis": {
            "title": "Mapped area on the common known footprint (million km²)",
            "values": [
              0,
              0.5,
              1,
              1.5
            ],
            "format": ".1f"
          }
        },
        "opacity": {
          "condition": {
            "test": "landscapeFocus == 0 || datum.mvg_code == landscapeFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "type": "nominal",
            "title": "Vegetation type"
          },
          {
            "field": "estimated_pre1750_km2",
            "type": "quantitative",
            "title": "Estimated pre-1750 area (km²)",
            "format": ",.0f"
          },
          {
            "field": "extant_km2",
            "type": "quantitative",
            "title": "Extant area (km²)",
            "format": ",.0f"
          },
          {
            "field": "net_category_area_difference_km2",
            "type": "quantitative",
            "title": "Extant minus pre-1750 (km²)",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "fill": "#315d49",
        "stroke": "#315d49",
        "size": 55,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "estimated_pre1750_km2",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 265
          }
        },
        "x": {
          "field": "ext_million_km2",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1.5
            ],
            "nice": false,
            "zero": true
          },
          "axis": {
            "title": "Mapped area on the common known footprint (million km²)",
            "values": [
              0,
              0.5,
              1,
              1.5
            ],
            "format": ".1f"
          }
        },
        "opacity": {
          "condition": {
            "test": "landscapeFocus == 0 || datum.mvg_code == landscapeFocus",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "type": "nominal",
            "title": "Vegetation type"
          },
          {
            "field": "estimated_pre1750_km2",
            "type": "quantitative",
            "title": "Estimated pre-1750 area (km²)",
            "format": ",.0f"
          },
          {
            "field": "extant_km2",
            "type": "quantitative",
            "title": "Extant area (km²)",
            "format": ",.0f"
          },
          {
            "field": "net_category_area_difference_km2",
            "type": "quantitative",
            "title": "Extant minus pre-1750 (km²)",
            "format": "+,.0f"
          }
        ]
      }
    }
  ]
}
